# Environment Variables for SpeakUp Coach
# Copy this file to .env and fill in your actual values

# Anthropic API for AI feedback
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stripe for payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_PRO_LIFETIME_PRICE_ID=price_your_lifetime_price_id
STRIPE_TEAM_5_PRICE_ID=price_team_5_seats
STRIPE_TEAM_10_PRICE_ID=price_team_10_seats
STRIPE_TEAM_20_PRICE_ID=price_team_20_seats

# Email service for reminders
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Base URL for the application
BASE_URL=http://localhost:3000